# Copy this file to .env locally and fill in the values you need.
# Do not commit a real .env file containing real secrets.

SECRET_KEY=change-me-in-production
FLASK_ENV=development
APP_ENV=development
# Production/postgres example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lead_intelligence
# Local convenience fallback for SQLite only:
# DATABASE_URL=sqlite:///lead_system.db
TEST_DATABASE_URL=sqlite:///:memory:
